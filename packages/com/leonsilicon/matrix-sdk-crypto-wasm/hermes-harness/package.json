{
  "name": "@-/com.leonsilicon.matrix-sdk-crypto-wasm.hermes-harness",
  "version": "0.0.0",
  "private": true,
  "description": "Runs react-native-matrix-sdk-crypto-wasm's bridge and generated module in Hermes through JSI, outside an app, with checks and a benchmark.",
  "bin": {
    "_test-hermes": "./_test-hermes.ts"
  },
  "type": "module",
  "imports": {
    "#bench": "./bench.ts",
    "#fixtures/*": "./@fixtures/*",
    "#harness-env": "./harness-env.ts",
    "#hermes": "./hermes.ts",
    "#test-hermes": "./test-hermes.ts"
  },
  "exports": {
    ".": "./+.ts"
  },
  "dependencies": {
    "esbuild": "catalog:",
    "react-native-matrix-sdk-crypto-wasm": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}
